# apps/web/.env.local  (never commit the real file)
# Optional if you are logged in with the Nansen CLI (`nansen login`): the backend falls back to ~/.nansen/config.json
NANSEN_API_KEY=
# Daily credit cap enforced by the backend cache/ledger (the global ceiling when hosted)
NANSEN_DAILY_CREDIT_CAP=3000
# Hosted deployments only (see docs/DEPLOYMENT.md). Leave unset to self-host.
# TRIPWIRE_HOSTED=1
# TRIPWIRE_HOSTED_HOST=tripwire.magician.wtf
# NANSEN_PER_INSTALL_DAILY_CREDITS=3000
# NANSEN_GLOBAL_DAILY_CREDITS=20000
# TRIPWIRE_IP_SALT=      (secret)
# TRIPWIRE_OWNER_TOKEN=  (secret)
# Serve recorded fixtures instead of calling Nansen (tests / offline)
TRIPWIRE_REPLAY=0
